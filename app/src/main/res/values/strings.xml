<?xml version="1.0" encoding="utf-8"?>
<!--
    English (en-US) — the source language. This unqualified values/ folder is both the English
    copy and the fallback for any key a translation has not covered yet, so nothing here may be
    deleted just because a translated file exists.

    To add a language, copy this file to values-<code>/strings.xml (values-fr, values-de,
    values-hi, values-pt-rBR …) and translate the values only — never the name attributes. AGP
    regenerates the locale config from the folders that exist, so the language then appears in
    Android 13+'s per-app language picker with no further wiring.

    Leave a key out of a translation and English is used for it; lint's MissingTranslation check
    reports those once a second locale exists.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="app_name">yata</string>
    <string name="share_to_task_label">Add to Yata</string>
    <string name="qs_tile_quick_add_label">Quick add task</string>

    <!-- Tasker "Create Task" plugin field labels -->
    <string name="tasker_field_title">Title</string>
    <string name="tasker_field_project">Project (name)</string>
    <string name="tasker_field_list">List (name)</string>
    <string name="tasker_field_tags">Tags (comma-separated)</string>
    <string name="tasker_field_assignees">Assign to (comma-separated names)</string>
    <string name="tasker_field_due">Due date (e.g. 2026-07-10, tomorrow, next monday)</string>
    <string name="tasker_field_time">Time (e.g. 3:00 PM, 15:00, evening)</string>
    <string name="tasker_field_reminder">Reminder (e.g. 15 min before, 1 day before)</string>
    <string name="tasker_field_priority">Priority (none, low, med, high)</string>
    <string name="tasker_field_section">Section (Morning or Afternoon)</string>
    <string name="tasker_field_repeat">Repeat (e.g. daily, every monday, every 2 weeks)</string>
    <string name="tasker_field_notes">Notes</string>

